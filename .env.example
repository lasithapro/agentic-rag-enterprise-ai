# ============================================================
# Agentic RAG Enterprise AI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---- LLM Configuration ----
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1

# ---- Application ----
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Security ----
SECRET_KEY=change-me-to-a-strong-random-secret-key-at-least-32-chars

# ---- Document Processing ----
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
